<Window x:Class="Naloga3_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue"    Color="#1A3A6B"/>
        <SolidColorBrush x:Key="LightBlue"      Color="#2E6DA4"/>
        <SolidColorBrush x:Key="AccentBlue"     Color="#4A9FD4"/>
        <SolidColorBrush x:Key="BackgroundGray" Color="#F4F6F9"/>
        <SolidColorBrush x:Key="BorderGray"     Color="#D0D8E4"/>
        <SolidColorBrush x:Key="TextDark"       Color="#1C2B40"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#2E6DA4"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A5080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A3A6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#C0392B"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#1C2B40"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Margin"       Value="0,6,0,2"/>
        </Style>

        <Style x:Key="FormBox" TargetType="TextBox">
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="BorderBrush"     Value="#D0D8E4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundGray}">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBlue}">
            <Grid Margin="15,0">
                <TextBlock Text="{Binding NaslovAplikacije}" Foreground="White"
                           FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="{Binding JezikGumb}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                        Command="{Binding PreklopJezikCmd}"/>
            </Grid>
        </Border>

        <!-- TABS -->
        <TabControl Grid.Row="1" Margin="10" Background="White"
                    BorderBrush="{StaticResource BorderGray}">

            <!-- TAB 1: TEKMOVALCI -->
            <TabItem Header="{Binding TabTekmovalci}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ISKALNA VRSTICA -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding IskalniNiz, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormBox}"
                                     Tag="{Binding IskalniPlaceholder}">
                                <TextBox.Resources>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource FormBox}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="{Binding IskalniPlaceholder}"
                                                                           Foreground="Gray" Margin="8,5" FontSize="13"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <ComboBox Grid.Column="1" Margin="8,0"
                                      ItemsSource="{Binding FilterDrzave}"
                                      SelectedItem="{Binding IzbranaDrzava}"
                                      Width="130" Padding="8,5"/>
                            <Button Grid.Column="2"
                                    Content="{Binding GumbPocistiFilter}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding PocistiFilterCmd}"/>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="#D0D8E4" BorderThickness="1" Margin="0,0,8,0">
                        <DataGrid x:Name="GridTekmovalci"
                                  ItemsSource="{Binding Tekmovalci}"
                                  SelectedItem="{Binding IzbranTekmovalec}"
                                  SelectionChanged="GridTekmovalci_SelectionChanged"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"      Binding="{Binding Id}"       Width="50"/>
                                <DataGridTextColumn Header="Ime"     Binding="{Binding Ime}"      Width="*"/>
                                <DataGridTextColumn Header="Priimek" Binding="{Binding Priimek}"  Width="*"/>
                                <DataGridTextColumn Header="Starost" Binding="{Binding Starost}"  Width="70"/>
                                <DataGridTextColumn Header="Država"  Binding="{Binding Drzava}"   Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="0">
                        <TextBlock Text="{Binding FormNaslovTekmovalec}" FontSize="15"
                                   FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,10"/>

                        <TextBlock Text="Ime" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TIme, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>

                        <TextBlock Text="Priimek" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TPriimek, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>

                        <TextBlock Text="Starost" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TStarost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>

                        <TextBlock Text="Kraj" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TKraj, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>

                        <TextBlock Text="Država" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TDrzava, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>

                        <TextBlock Text="Poklic" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TPoklic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Content="{Binding GumbShrani}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ShraniTekmovalecCmd}" Margin="0,0,8,0"/>
                            <Button Content="{Binding GumbIzbrisi}" Style="{StaticResource DangerButton}"
                                    Command="{Binding IzbrisiTekmovalecCmd}" Margin="0,0,8,0"/>
                            <Button Content="{Binding GumbNov}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding NovTekmovalecCmd}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: TEKMOVANJA -->
            <TabItem Header="{Binding TabTekmovanja}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#D0D8E4" BorderThickness="1" Margin="0,0,8,0">
                        <DataGrid x:Name="GridTekmovanja"
                                  ItemsSource="{Binding Tekmovanja}"
                                  SelectedItem="{Binding IzbranTekmovanje}"
                                  SelectionChanged="GridTekmovanja_SelectionChanged"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"       Binding="{Binding Id}"        Width="50"/>
                                <DataGridTextColumn Header="Naziv"    Binding="{Binding Naziv}"     Width="*"/>
                                <DataGridTextColumn Header="Lokacija" Binding="{Binding Lokacija}"  Width="*"/>
                                <DataGridTextColumn Header="Datum"    Binding="{Binding Datum}"     Width="100"/>
                                <DataGridTextColumn Header="Tip"      Binding="{Binding Tip}"       Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding FormNaslovTekmovanje}" FontSize="15"
                                   FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,10"/>

                        <TextBlock Text="Naziv" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TNaziv, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>

                        <TextBlock Text="Lokacija" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TLokacija, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>

                        <TextBlock Text="Datum" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TDatum, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>

                        <TextBlock Text="Tip" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TTip, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Content="{Binding GumbShrani}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ShraniTekmovanjeCmd}" Margin="0,0,8,0"/>
                            <Button Content="{Binding GumbIzbrisi}" Style="{StaticResource DangerButton}"
                                    Command="{Binding IzbrisiTekmovanjeCmd}" Margin="0,0,8,0"/>
                            <Button Content="{Binding GumbNov}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding NovTekmovanjeCmd}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: REZULTATI -->
            <TabItem Header="{Binding TabRezultati}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ORODNA VRSTICA REZULTATI -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{Binding GumbIzvozCSV}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding IzvozCSVCmd}"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding RezultatiStevilka}"
                                   VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="#D0D8E4" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding Rezultati}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"          Binding="{Binding Id}"            Width="50"/>
                                <DataGridTextColumn Header="Tekmovalec"  Binding="{Binding Tekmovalec}"    Width="*"/>
                                <DataGridTextColumn Header="Tekmovanje"  Binding="{Binding Tekmovanje}"    Width="*"/>
                                <DataGridTextColumn Header="Čas"         Binding="{Binding CasFinish}"     Width="100"/>
                                <DataGridTextColumn Header="Mesto"       Binding="{Binding Mesto}"         Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: STATISTIKA -->

            <TabItem Header="{Binding TabStatistika}">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <TextBlock Text="{Binding StatNaslov}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,10"/>

                        <WrapPanel Margin="0,0,0,15">
                            <Border Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
                                    CornerRadius="8" Padding="20,15" Margin="0,0,15,15" MinWidth="160">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatSkupajTekmovalcev}" FontSize="28"
                                               FontWeight="Bold" Foreground="{StaticResource LightBlue}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatLabelTekmovalcev}" FontSize="12"
                                               Foreground="Gray" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
                                    CornerRadius="8" Padding="20,15" Margin="0,0,15,15" MinWidth="160">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatSkupajTekmovanj}" FontSize="28"
                                               FontWeight="Bold" Foreground="{StaticResource LightBlue}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatLabelTekmovanj}" FontSize="12"
                                               Foreground="Gray" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#D0D8E4" BorderThickness="1"
                                    CornerRadius="8" Padding="20,15" Margin="0,0,15,15" MinWidth="160">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatSkupajRezultatov}" FontSize="28"
                                               FontWeight="Bold" Foreground="{StaticResource LightBlue}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatLabelRezultatov}" FontSize="12"
                                               Foreground="Gray" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="{Binding StatPoTipihNaslov}" FontSize="14"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border Background="White" BorderBrush="#D0D8E4" BorderThickness="1">
                            <DataGrid ItemsSource="{Binding StatPoTipih}" BorderThickness="0" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tip tekmovanja" Binding="{Binding Tip}"        Width="*"/>
                                    <DataGridTextColumn Header="Tekmovanj"      Binding="{Binding Tekmovanj}" Width="150"/>
                                    <DataGridTextColumn Header="Rezultatov"     Binding="{Binding Rezultatov}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- TAB 5: UPORABNIKI -->
            <TabItem Header="{Binding TabUporabniki}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#D0D8E4" BorderThickness="1" Margin="0,0,8,0">
                        <DataGrid x:Name="GridUporabniki"
                                  ItemsSource="{Binding Uporabniki}"
                                  SelectedItem="{Binding IzbranUporabnik}"
                                  SelectionChanged="GridUporabniki_SelectionChanged"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"       Binding="{Binding Id}"              Width="50"/>
                                <DataGridTextColumn Header="Ime"      Binding="{Binding UporabniskoIme}"  Width="*"/>
                                <DataGridTextColumn Header="Vloga"    Binding="{Binding Vloga}"           Width="100"/>
                                <DataGridTextColumn Header="Email"    Binding="{Binding Email}"           Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding FormNaslovUporabnik}" FontSize="15"
                                   FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,10"/>

                        <TextBlock Text="Uporabniško ime" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TUporabniskoIme, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>

                        <TextBlock Text="Email" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding TEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormBox}"/>

                        <TextBlock Text="Vloga" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding VlogaOpcije}"
                                  SelectedItem="{Binding TVloga}"
                                  Padding="8,5" Margin="0,2,0,0"/>

                        <TextBlock Text="Geslo (novo)" Style="{StaticResource FormLabel}"/>
                        <PasswordBox x:Name="PbGeslo"
                                     Padding="8,5" BorderBrush="#D0D8E4" BorderThickness="1"
                                     FontSize="13" Margin="0,2,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Content="{Binding GumbShrani}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ShraniUporabnikCmd}" Margin="0,0,8,0"/>
                            <Button Content="{Binding GumbIzbrisi}" Style="{StaticResource DangerButton}"
                                    Command="{Binding IzbrisiUporabnikCmd}" Margin="0,0,8,0"/>
                            <Button Content="{Binding GumbNov}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding NovUporabnikCmd}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUSNA VRSTICA -->
        <Border Grid.Row="2" Background="#1A3A6B" Padding="12,0">
            <TextBlock Text="{Binding StatusSporocilo}" Foreground="White"
                       VerticalAlignment="Center" FontSize="12"/>
        </Border>
    </Grid>
</Window>
