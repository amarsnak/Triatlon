@page
@model Naloga4_Splet.Pages.TekmovanjaModel
@{
    ViewData["Title"] = "Tekmovanja";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="fas fa-flag me-2 text-primary"></i>Tekmovanja</h2>

    <!-- FILTER -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="lokacija" value="@Model.Lokacija"
                           class="form-control" placeholder="🔍 Išči po lokaciji..." />
                </div>
                <div class="col-md-3">
                    <select name="tip" class="form-select">
                        <option value="">— Vsi tipi —</option>
                        <option value="IRONMAN" selected="@(Model.Tip == "IRONMAN")">IRONMAN</option>
                        <option value="IRONMAN70.3" selected="@(Model.Tip == "IRONMAN70.3")">IRONMAN 70.3</option>
                        <option value="Ultra-triatlon" selected="@(Model.Tip == "Ultra-triatlon")">Ultra-triatlon</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-2"></i>Filtriraj
                    </button>
                </div>
                <div class="col-md-2">
                    <a href="/Tekmovanja" class="btn btn-outline-secondary w-100">Počisti</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between">
            <span><i class="fas fa-calendar me-2"></i>Seznam tekmovanj</span>
            <span class="badge bg-light text-dark">@Model.Tekmovanja.Count tekmovanj</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Naziv</th>
                            <th>Lokacija</th>
                            <th>Tip</th>
                            <th>Datum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Tekmovanja)
                        {
                            <tr>
                                <td class="text-muted small">@t.Id</td>
                                <td><strong>@t.Naziv</strong></td>
                                <td>@(t.Lokacija ?? "—")</td>
                                <td>
                                    <span class="badge @(t.Tip == "IRONMAN" ? "bg-danger" : t.Tip == "IRONMAN70.3" ? "bg-warning text-dark" : "bg-success")">
                                        @t.Tip
                                    </span>
                                </td>
                                <td>@(t.Datum?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td>
                                    <a href="/Lestvica?tekmovanjeId=@t.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-trophy me-1"></i>Lestvica
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
