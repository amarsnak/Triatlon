@page
@model Naloga4_Splet.Pages.LestvicaModel
@{
    ViewData["Title"] = "Lestvica";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="fas fa-trophy me-2 text-warning"></i>Lestvica tekmovanja</h2>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-8">
                    <select name="tekmovanjeId" class="form-select">
                        <option value="">— Izberi tekmovanje —</option>
                        @foreach (var t in Model.VsaTekmovanja)
                        {
                            <option value="@t.Id" selected="@(Model.TekmovanjeId == t.Id)">
                                @t.Naziv (@(t.Datum?.ToString("yyyy") ?? "?")) — @t.Lokacija
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-trophy me-2"></i>Prikaži
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Lestvica.Any())
    {
        <div class="card">
            <div class="card-header">
                <i class="fas fa-medal me-2"></i>
                @Model.IzbranTekmovanje?.Naziv — @(Model.IzbranTekmovanje?.Datum?.ToString("dd.MM.yyyy") ?? "")
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Mesto</th>
                                <th>Tekmovalec</th>
                                <th>Država</th>
                                <th>Plavanje</th>
                                <th>Kolesarjenje</th>
                                <th>Tek</th>
                                <th>Skupni čas</th>
                                <th>Točke</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Lestvica)
                            {
                                <tr class="@(v.Uvrstitev <= 3 ? "table-warning" : "")">
                                    <td>
                                        @if (v.Uvrstitev == 1) { <span class="fs-5">🥇</span> }
                                        else if (v.Uvrstitev == 2) { <span class="fs-5">🥈</span> }
                                        else if (v.Uvrstitev == 3) { <span class="fs-5">🥉</span> }
                                        else { <span>@v.Uvrstitev</span> }
                                    </td>
                                    <td><strong>@v.Ime @v.Priimek</strong></td>
                                    <td><span class="badge bg-secondary">@(v.Drzava ?? "—")</span></td>
                                    <td>@(v.CasPlavanje ?? "—")</td>
                                    <td>@(v.CasKolesarjenje ?? "—")</td>
                                    <td>@(v.CasTek ?? "—")</td>
                                    <td><strong class="text-primary">@(v.CasSkupni ?? "—")</strong></td>
                                    <td>@(v.Tocke?.ToString("F0") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (Model.TekmovanjeId.HasValue)
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>Za to tekmovanje ni rezultatov.
        </div>
    }
</div>
