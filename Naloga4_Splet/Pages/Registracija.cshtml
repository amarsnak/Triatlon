@page
@model Naloga4_Splet.Pages.RegistracijaModel
@{
    ViewData["Title"] = "Registracija";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header text-center">
                    <i class="fas fa-user-plus me-2"></i>Registracija
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.Napaka))
                    {
                        <div class="alert alert-danger">@Model.Napaka</div>
                    }
                    @if (Model.Uspesno)
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-check me-2"></i>
                            Registracija uspešna! <a href="/Prijava">Prijavi se</a>.
                        </div>
                    }
                    else
                    {
                        <form method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Uporabniško ime</label>
                                <input type="text" name="uporabniskoIme" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Email</label>
                                <input type="email" name="email" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Geslo</label>
                                <input type="password" name="geslo" class="form-control" required minlength="6" />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-user-plus me-2"></i>Registracija
                            </button>
                        </form>
                        <hr />
                        <div class="text-center">
                            <small>Že imate račun? <a href="/Prijava">Prijava</a></small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
